# Copy to .env or server/.env. No keys required for offline mock mode.
PORT=4000
CONNECTOR=airwallex
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AUDIT_LOG_PATH=/absolute/path/to/audit.jsonl
# --- Live updates (docs/LIVE_UPDATES.md) ---
# AIRWALLEX_WEBHOOK_SECRET=            # webhook endpoint returns 503 (fail closed) until set
# AIRWALLEX_WEBHOOK_TOLERANCE_SECONDS=300
# AIRWALLEX_WEBHOOK_VERSION=2025-06-30 # used by npm run webhook:register
# AIRWALLEX_POLL=on                    # set to off to disable the polling fallback
# AIRWALLEX_POLL_INTERVAL_SECONDS=10
# AIRWALLEX_STUCK_AFTER_SECONDS=120    # PROCESSING longer than this = stuck incident
# AIRWALLEX_POLL_LOOKBACK_MINUTES=15
# ATLAS_AUTORUN=true                   # auto-run the governed agent on detected incidents

# Kit 11 (x402 Business Agents). Leave METAL_RPC_URL empty for the labelled simulation.
# A Metal testnet RPC URL is a secret: keep it here, never commit it.
METAL_RPC_URL=
# METAL_MODE=testnet|simulation (default: testnet when METAL_RPC_URL is set)
